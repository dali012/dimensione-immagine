# Frontend (Vite)
VITE_RECAPTCHA_SITE_KEY=

# Optional: simple password gate for /hr-cv-link page
VITE_HR_PAGE_PASSWORD=

# Backend (Vercel serverless API)
SECRET_KEY=

# Cloudflare R2 / S3-compatible storage
BUCKET_NAME=
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# PostgreSQL
DATABASE_URL=
# For Neon/managed Postgres, prefer SSL full verification in production:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Resend email notifications (optional)
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=
# Optional fallback is RESEND_FROM_EMAIL
RESEND_APPLICANT_FROM_EMAIL=
# Optional reply-to override for contact form emails
CONTACT_REPLY_TO_EMAIL=

# Public app URL used to build GDPR delete links
APP_URL=https://www.dimensioneimmagineabbigliamento.it

# API auth for HR signed CV link endpoint
HR_API_TOKEN=

# Contact API anti-spam IP hashing salt (set a long random string in production)
CONTACT_IP_SALT=
